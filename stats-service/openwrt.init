#!/bin/sh /etc/rc.common
# 旁路运行，不改动或重启 Nikki。
USE_PROCD=1
START=95
STOP=10

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/python3 /opt/zashboard-stats/service.py --config /etc/zashboard-stats/config.json
    procd_set_param env PYTHONDONTWRITEBYTECODE=1
    procd_set_param respawn 3600 5 5
    procd_set_param file /etc/zashboard-stats/config.json
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

reload_service() {
    stop
    start
}
